includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
    tmpDir: build/phpstan
    ignoreErrors:
        # The getResponse() guard is required for Guzzle 8, but always true for Guzzle 7.
        -
            message: '#^Call to function method_exists\(\) with GuzzleHttp\\Exception\\RequestException and ''getResponse'' will always evaluate to true\.$#'
            identifier: function.alreadyNarrowedType
            path: src/CrawlObservers/CollectUrlsObserver.php
            reportUnmatched: false
        # pcntl_signal_get_handler() can return a private or protected method of another class.
        # The crawler cannot call that handler, so it must not replace it.
        -
            message: '#^Call to function is_callable\(\) with callable\(\)\: mixed will always evaluate to true\.$#'
            identifier: function.alreadyNarrowedType
            path: src/Crawler.php
        -
            message: '#^Result of && is always false\.$#'
            identifier: booleanAnd.alwaysFalse
            path: src/Crawler.php
